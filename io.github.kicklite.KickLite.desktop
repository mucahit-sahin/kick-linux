#!/usr/bin/env xdg-open
[Desktop Entry]
Name=Kick Lite
Comment=Lightweight Kick.com livestream and VOD player
Exec=kick-lite %U
Icon=io.github.kicklite.KickLite
Terminal=false
Type=Application
Categories=AudioVideo;Video;Player;
MimeType=x-scheme-handler/kick;
Keywords=Kick;stream;video;VOD;
StartupNotify=true
